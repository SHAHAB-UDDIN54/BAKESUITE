{
  "name": "bakesuite",
  "version": "1.0.0",
  "private": true,
  "description": "BakeSuite ERP - Enterprise Bakery Management System for Pakistan",
  "scripts": {
    "dev:erp": "npm --prefix apps/erp-core run dev",
    "dev:ml": "py -3.12 -m uvicorn main:app --app-dir apps/ml-service --host 0.0.0.0 --port 8000 --reload",
    "build:erp": "npm --prefix apps/erp-core run build",
    "test:erp": "npm --prefix apps/erp-core test",
    "test:circuit-breaker": "npm --prefix apps/erp-core run test:circuit-breaker",
    "test:ml": "py -3.12 -m pytest apps/ml-service"
  },
  "workspaces": [
    "apps/erp-core"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "BakeSuite Team",
  "license": "UNLICENSED"
}
