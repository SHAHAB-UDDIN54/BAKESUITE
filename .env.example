# ==========================================
# BakeSuite Root Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bakesuite

# ERP Core Service
ERP_PORT=3000
ERP_ENV=development
ERP_URL=http://localhost:3000

# ML Microservice
ML_PORT=8000
ML_ENV=development
ML_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# Regional & Business Constants
TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR
