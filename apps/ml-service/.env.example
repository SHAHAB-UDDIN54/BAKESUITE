PORT=8000
ENVIRONMENT=development

# Dedicated ML Database connection strictly targeting 'ml' schema
DATABASE_URL=postgresql://postgres:@localhost:5432/bakesuite
DB_SCHEMA=ml

# Redis Feature Store (or In-Memory Fallback if unreachable)
REDIS_URL=redis://localhost:6379/0
USE_MOCK_CACHE=true

# Regional
TIMEZONE=Asia/Karachi
